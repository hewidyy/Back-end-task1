{
  "name": "back-end-task1",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal Node.js backend starter with a JSON API and health check.",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "check": "node --check src/app.js && node --check src/server.js",
    "test": "node --test"
  }
}
